# Modèle de configuration de production.
#
#   cp infra/.env.prod.example infra/.env.prod
#
# `infra/.env.prod` est ignoré par git : il ne doit JAMAIS être committé.
# Toutes les commandes docker compose de production doivent le passer
# explicitement via `--env-file infra/.env.prod`.

# ---------------------------------------------------------------- Postgres --
POSTGRES_DB=locadirect_db
POSTGRES_USER=locadirect
# openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=CHANGE_ME

# L'hôte est `postgres` : le nom du service dans le réseau Docker, pas
# localhost. Si le mot de passe contient des caractères réservés d'URL
# (@ : / ? # [ ] %), il doit être encodé ici en pourcentage.
DATABASE_URL=postgresql://locadirect:CHANGE_ME@postgres:5432/locadirect_db?schema=public

# -------------------------------------------------------------------- JWT --
# Deux secrets DISTINCTS, longs et aléatoires : openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# -------------------------------------------------------------------- OTP --
# "console" : le code est écrit dans les journaux du conteneur (pas d'envoi
# réel). "campay" : envoi SMS, nécessite SMS_API_KEY.
OTP_PROVIDER=console
SMS_API_KEY=

# ----------------------------------------------------------------- Google --
# Client ID de type « Application Web », utilisé comme audience pour vérifier
# les idToken envoyés par l'app mobile.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------- CORS --
# Origines autorisées, séparées par des virgules. Le back-office est servi sur
# la même origine que l'API : il n'a besoin d'aucune entrée ici. Ne renseigner
# que des origines réellement tierces (site public sur un autre domaine, etc.).
# Vide = aucune origine navigateur tierce autorisée. Les apps mobiles natives
# n'envoient pas d'en-tête Origin et ne sont donc pas concernées.
CORS_ORIGINS=

# ------------------------------------------------- Données de démonstration --
# `true` fait amorcer par l'API, à chaque démarrage, les villes de Douala et
# Yaoundé et deux annonces fictives (GeoService.onModuleInit et
# AnnoncesService.onModuleInit). À laisser à `false` en production.
SEED_DEMO_DATA=false

# ------------------------------------------------------------ Back-office --
# URL relative par défaut : même origine, servie par nginx. À ne changer que si
# l'API est publiée sur un domaine distinct — auquel cas il faudra renseigner
# CORS_ORIGINS en conséquence.
NEXT_PUBLIC_API_URL=/api/v1
