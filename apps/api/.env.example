# Copier ce fichier vers .env et renseigner de vraies valeurs.
# .env est ignoré par git (voir .gitignore) : ne jamais committer de vrais secrets.

DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/locadirect_db?schema=public"

# Secrets JWT — générer des valeurs aléatoires longues en production
# (ex: `openssl rand -base64 48`). Le code retombe sur une valeur par défaut
# non sécurisée si absent — uniquement acceptable en dev local.
JWT_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"

# Fournisseur d'envoi OTP : "console" (log serveur, dev) | "campay" (SMS réel, non finalisé)
OTP_PROVIDER="console"
SMS_API_KEY=""

# Google Sign-In — Web Client ID utilisé pour vérifier l'audience des idToken
# envoyés par l'app mobile (Android/iOS ont leurs propres Client ID côté client).
GOOGLE_CLIENT_ID=""

NODE_ENV="development"
PORT=3000
